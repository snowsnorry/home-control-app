    "Your Mac and iPhone must be on the same local network. Sharing requires Home Control to be running and your Mac to be awake. The accessory requires fresh temperature, humidity, PM2.5 and PM10 readings. If any reading is unavailable or 120 seconds old, all shared readings become unavailable until fresh data returns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac and iPhone must be on the same local network. Sharing requires Home Control to be running and your Mac to be awake. The accessory requires fresh temperature, humidity, PM2.5 and PM10 readings. If any reading is unavailable or 120 seconds old, all shared readings become unavailable until fresh data returns."
          }
        }
      }
    },
    "Share sensors and control with Apple Home": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share sensors and control with Apple Home"
          }
        }
      }
    },
    "Apple Home can control power, Auto/Manual mode and fan speed. Your Mac and iPhone must be on the same local network. Home Control must be running and your Mac awake. Sharing requires fresh temperature, humidity, PM2.5 and PM10 readings. If any reading is unavailable or 120 seconds old, sensors and purifier control become unavailable until fresh data returns.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Home can control power, Auto/Manual mode and fan speed. Your Mac and iPhone must be on the same local network. Home Control must be running and your Mac awake. Sharing requires fresh temperature, humidity, PM2.5 and PM10 readings. If any reading is unavailable or 120 seconds old, sensors and purifier control become unavailable until fresh data returns."
          }
        }
      }
    }
  },
  "version": "1.0"
}
